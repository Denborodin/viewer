#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
1 RT_MANIFEST "viewer.manifest"
IDI_VIEWER ICON "viewer.ico"
IDD_SETTINGS DIALOGEX 0,0,360,244
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Настройки Viewer"
FONT 9,"Segoe UI"
BEGIN
 LTEXT "Кеш в памяти, МиБ (64–4096):",-1,12,14,180,12
 EDITTEXT IDC_RAM,240,12,90,15,ES_NUMBER | WS_TABSTOP | WS_BORDER
 LTEXT "Кеш на диске, МиБ (0 — отключить):",-1,12,40,210,12
 EDITTEXT IDC_DISK,240,38,90,15,ES_NUMBER | WS_TABSTOP | WS_BORDER
 LTEXT "Память текстур GPU, МиБ (32–1024):",-1,12,66,210,12
 EDITTEXT IDC_GPU,240,64,90,15,ES_NUMBER | WS_TABSTOP | WS_BORDER
 PUSHBUTTON "Очистить кеш",IDC_CLEAR,12,89,105,20
 GROUPBOX "Интеграция с Windows 11",-1,12,120,336,78
 LTEXT "Проверка регистрации…",IDC_SHELL_STATUS,22,134,316,24
 PUSHBUTTON "Включить",IDC_ENABLE_SHELL,22,168,91,20
 PUSHBUTTON "Отключить",IDC_DISABLE_SHELL,122,168,91,20
 PUSHBUTTON "Восстановить",IDC_REPAIR_SHELL,222,168,113,20
 DEFPUSHBUTTON "Сохранить",IDOK,170,213,85,20
 PUSHBUTTON "Закрыть",IDCANCEL,264,213,84,20
END
